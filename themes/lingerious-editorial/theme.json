{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        { "slug": "ivory", "name": "Ivory", "color": "#f8f3ed" },
        { "slug": "warm-white", "name": "Warm White", "color": "#fffaf5" },
        { "slug": "espresso", "name": "Espresso", "color": "#231815" },
        { "slug": "cocoa", "name": "Cocoa", "color": "#5f4740" },
        { "slug": "rose-clay", "name": "Rose Clay", "color": "#c7a29a" },
        { "slug": "silk", "name": "Silk", "color": "#e7d4c8" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "editorial-serif",
          "name": "Editorial Serif",
          "fontFamily": "Georgia, 'Times New Roman', serif"
        },
        {
          "slug": "clean-sans",
          "name": "Clean Sans",
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#fffaf5",
      "text": "#231815"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--clean-sans)",
      "fontSize": "16px",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "border": { "radius": "999px" },
        "color": { "background": "#231815", "text": "#fffaf5" },
        "typography": { "fontSize": "12px", "fontWeight": "600", "letterSpacing": "0.14em", "textTransform": "uppercase" },
        "spacing": { "padding": { "top": "0.9rem", "right": "1.4rem", "bottom": "0.9rem", "left": "1.4rem" } }
      },
      "link": {
        "color": { "text": "#231815" },
        "typography": { "textDecoration": "none" }
      }
    }
  }
}
